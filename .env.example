# Razorpay Environment Variables
# Public key accessible in the browser (for Razorpay Checkout modal)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx

# Secret key kept strictly on the server (for creating orders & verifying signatures)
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Webhook Secret (optional, for verifying webhook events from Razorpay Dashboard)
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
